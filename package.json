{
  "name": "iziphone",
  "version": "0.1.0",
  "description": "A source-available business phone system for teams, powered by Twilio.",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "check": "biome check . && turbo run typecheck test",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "turbo run clean",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "prisma": "^7.10.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  }
}
