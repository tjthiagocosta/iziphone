# Copy to .env at the repository root. Every service and the Prisma CLI read this one file.
# Never commit .env. Use only fictional values (555-01xx numbers, example.com addresses) in examples.

# --- Infrastructure -----------------------------------------------------------
# docker-compose.dev.yml reads POSTGRES_* and the host ports below.
DATABASE_URL=postgresql://iziphone:iziphone123@localhost:5432/iziphone
POSTGRES_USER=iziphone
POSTGRES_PASSWORD=iziphone123
POSTGRES_DB=iziphone
# POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
# REDIS_PORT=6379

# --- Runtime ------------------------------------------------------------------
# `development` disables Twilio signature validation and secure cookies. Never use it on a reachable host.
NODE_ENV=development
LOG_LEVEL=info

# --- API (apps/api) -----------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0
# Signs sessions and the realtime JWT. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-local-dev-secret
# Public URL of the API. Auth callbacks, Twilio messaging webhooks and media links are built on it.
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
# Shared secret the call controller presents on the API's /internal routes. Generate with: openssl rand -base64 32
INTERNAL_API_TOKEN=replace-with-a-local-internal-token
# Routing cache TTL in Redis, in seconds (default 24h)
DEPARTMENT_CACHE_TTL_SECONDS=86400
# Where inbound and outbound MMS attachments are stored on disk
MESSAGING_MEDIA_STORAGE_DIR=.data/messaging-media

# --- Call controller (apps/call-controller) -----------------------------------
CALL_CONTROLLER_PORT=3002
CALL_CONTROLLER_HOST=0.0.0.0
# Where the call controller reaches the API's /internal routes. Keep this on a private network.
INTERNAL_API_URL=http://localhost:3001

# --- Web (apps/web) -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CALL_CONTROLLER_URL=http://localhost:3002

# --- Twilio -------------------------------------------------------------------
# Public HTTPS base URL of the call controller, reachable by Twilio (e.g. an ngrok tunnel in development)
WEBHOOK_BASE_URL=https://your-public-call-controller-url.example.com
TWILIO_ACCOUNT_SID=ACyour_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_API_KEY=SKyour_twilio_api_key_here
TWILIO_API_SECRET=your_twilio_api_secret_here
TWILIO_TWIML_APP_SID=APyour_twiml_app_sid_here
# Default caller ID when a user has no assigned number (E.164)
TWILIO_PHONE_NUMBER=+15555550100
# Optional hold music (public MP3 or WAV). A Twilio-hosted track is used when empty.
TWILIO_HOLD_AUDIO_URL=
